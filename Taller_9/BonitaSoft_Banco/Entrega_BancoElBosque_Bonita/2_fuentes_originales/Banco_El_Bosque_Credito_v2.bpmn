<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BancoElBosque" targetNamespace="http://bancoelbosque.example/credito">
  <bpmn:collaboration id="Collab"><bpmn:participant id="Pool" name="Banco El Bosque - Crédito de libre inversión" processRef="Process_CreditoLibreInversion"/></bpmn:collaboration>
  <bpmn:process id="Process_CreditoLibreInversion" name="Banco El Bosque - Crédito de libre inversión" isExecutable="true">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="L_Asesor" name="Asesor de oficina">
        <bpmn:flowNodeRef>StartEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RegistroSolicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotificarCompletar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotificarExceso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DecisionCliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ReduceMonto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ActualizarMonto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AgendarFirma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RegistrarFirma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Firma</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Riesgos" name="Analista de riesgos">
        <bpmn:flowNodeRef>EstudioRiesgo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Riesgo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Financiero" name="Analista financiero">
        <bpmn:flowNodeRef>EstudioInterno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Interno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EstudioCentrales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Centrales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EstudioDIAN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DIAN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EstudioCapacidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Capacidad</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Abogado" name="Abogado">
        <bpmn:flowNodeRef>EstudioAntecedentes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Antecedentes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Director" name="Director">
        <bpmn:flowNodeRef>AprobacionDirector</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Director</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Cajero" name="Cajero">
        <bpmn:flowNodeRef>Desembolso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndAprobado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sistema" name="Sistema (notificaciones)">
        <bpmn:flowNodeRef>NotificarRechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndRechazo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent" name="Inicio de solicitud"/>
    <bpmn:userTask id="RegistroSolicitud" name="Registrar solicitud y documentos"/>
    <bpmn:userTask id="EstudioRiesgo" name="Estudio preliminar de riesgos"/>
    <bpmn:exclusiveGateway id="GW_Riesgo" name="¿Riesgo aprobado?" default="F07"/>
    <bpmn:serviceTask id="NotificarCompletar" name="Notificar por correo: completar información"/>
    <bpmn:userTask id="EstudioInterno" name="Estudio interno de anotaciones"/>
    <bpmn:exclusiveGateway id="GW_Interno" name="¿Sin anotaciones?" default="F10"/>
    <bpmn:userTask id="EstudioCentrales" name="Registrar consultas Datacrédito y CIFIN"/>
    <bpmn:exclusiveGateway id="GW_Centrales" name="¿Calificaciones superiores a 60?" default="F13"/>
    <bpmn:userTask id="EstudioDIAN" name="Registrar estado tributario DIAN"/>
    <bpmn:exclusiveGateway id="GW_DIAN" name="¿Cliente al día con DIAN?" default="F16"/>
    <bpmn:userTask id="EstudioCapacidad" name="Calcular capacidad de endeudamiento"/>
    <bpmn:exclusiveGateway id="GW_Capacidad" name="¿Monto dentro de la capacidad?" default="F19"/>
    <bpmn:serviceTask id="NotificarExceso" name="Notificar por correo: reducir monto"/>
    <bpmn:userTask id="DecisionCliente" name="Registrar decisión del cliente"/>
    <bpmn:exclusiveGateway id="GW_ReduceMonto" name="¿Acepta reducir el monto?" default="F24"/>
    <bpmn:userTask id="ActualizarMonto" name="Actualizar monto solicitado"/>
    <bpmn:userTask id="EstudioAntecedentes" name="Revisión jurídica y antecedentes"/>
    <bpmn:exclusiveGateway id="GW_Antecedentes" name="¿Sin requerimientos?" default="F27"/>
    <bpmn:userTask id="AprobacionDirector" name="Aprobación final del director"/>
    <bpmn:exclusiveGateway id="GW_Director" name="¿Aprobado por el director?" default="F30"/>
    <bpmn:userTask id="AgendarFirma" name="Agendar cita para firma del pagaré"/>
    <bpmn:userTask id="RegistrarFirma" name="Registrar datos y resultado de firma"/>
    <bpmn:exclusiveGateway id="GW_Firma" name="¿Pagaré firmado?" default="F34"/>
    <bpmn:userTask id="Desembolso" name="Realizar desembolso"/>
    <bpmn:endEvent id="EndAprobado" name="Crédito desembolsado"/>
    <bpmn:serviceTask id="NotificarRechazo" name="Notificar por correo: solicitud rechazada"/>
    <bpmn:endEvent id="EndRechazo" name="Solicitud rechazada"/>
    <bpmn:sequenceFlow id="F01" sourceRef="StartEvent" targetRef="RegistroSolicitud"/>
    <bpmn:sequenceFlow id="F02" sourceRef="RegistroSolicitud" targetRef="EstudioRiesgo"/>
    <bpmn:sequenceFlow id="F03" sourceRef="EstudioRiesgo" targetRef="GW_Riesgo"/>
    <bpmn:sequenceFlow id="F04" sourceRef="GW_Riesgo" targetRef="EstudioInterno" name="APROBADO"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="groovy">solicitud.estudioRiesgo.estado == "APROBADO"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F05" sourceRef="GW_Riesgo" targetRef="NotificarCompletar" name="DEVUELTO"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="groovy">solicitud.estudioRiesgo.estado == "DEVUELTO"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F06" sourceRef="NotificarCompletar" targetRef="RegistroSolicitud"/>
    <bpmn:sequenceFlow id="F07" sourceRef="GW_Riesgo" targetRef="NotificarRechazo" name="RECHAZADO"/>
    <bpmn:sequenceFlow id="F08" sourceRef="EstudioInterno" targetRef="GW_Interno"/>
    <bpmn:sequenceFlow id="F09" sourceRef="GW_Interno" targetRef="EstudioCentrales" name="APROBADO"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="groovy">solicitud.estudioInterno.estado == "APROBADO"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10" sourceRef="GW_Interno" targetRef="NotificarRechazo" name="RECHAZADO"/>
    <bpmn:sequenceFlow id="F11" sourceRef="EstudioCentrales" targetRef="GW_Centrales"/>
    <bpmn:sequenceFlow id="F12" sourceRef="GW_Centrales" targetRef="EstudioDIAN" name="APROBADO"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="groovy">solicitud.estudioDatacredito.calificacion &gt; 60 &amp;&amp; solicitud.estudioCifin.calificacion &gt; 60</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" sourceRef="GW_Centrales" targetRef="NotificarRechazo" name="RECHAZADO"/>
    <bpmn:sequenceFlow id="F14" sourceRef="EstudioDIAN" targetRef="GW_DIAN"/>
    <bpmn:sequenceFlow id="F15" sourceRef="GW_DIAN" targetRef="EstudioCapacidad" name="APROBADO"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="groovy">solicitud.estudioTributario.resultado == "AL_DIA"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16" sourceRef="GW_DIAN" targetRef="NotificarRechazo" name="RECHAZADO"/>
    <bpmn:sequenceFlow id="F17" sourceRef="EstudioCapacidad" targetRef="GW_Capacidad"/>
    <bpmn:sequenceFlow id="F18" sourceRef="GW_Capacidad" targetRef="EstudioAntecedentes" name="APROBADO"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="groovy">solicitud.montoSolicitado &lt;= solicitud.estudioCapacidad.capacidadEndeudamiento</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F19" sourceRef="GW_Capacidad" targetRef="NotificarExceso" name="EXCEDE"/>
    <bpmn:sequenceFlow id="F20" sourceRef="NotificarExceso" targetRef="DecisionCliente"/>
    <bpmn:sequenceFlow id="F21" sourceRef="DecisionCliente" targetRef="GW_ReduceMonto"/>
    <bpmn:sequenceFlow id="F22" sourceRef="GW_ReduceMonto" targetRef="ActualizarMonto" name="SI"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="groovy">decisionReducirMonto == true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F23" sourceRef="ActualizarMonto" targetRef="EstudioCapacidad"/>
    <bpmn:sequenceFlow id="F24" sourceRef="GW_ReduceMonto" targetRef="NotificarRechazo" name="NO"/>
    <bpmn:sequenceFlow id="F25" sourceRef="EstudioAntecedentes" targetRef="GW_Antecedentes"/>
    <bpmn:sequenceFlow id="F26" sourceRef="GW_Antecedentes" targetRef="AprobacionDirector" name="APROBADO"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="groovy">solicitud.estudioAntecedentes.resultado == "NO_REQUERIDO"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F27" sourceRef="GW_Antecedentes" targetRef="NotificarRechazo" name="RECHAZADO"/>
    <bpmn:sequenceFlow id="F28" sourceRef="AprobacionDirector" targetRef="GW_Director"/>
    <bpmn:sequenceFlow id="F29" sourceRef="GW_Director" targetRef="AgendarFirma" name="APROBADO"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="groovy">solicitud.aprobacionFinal.estado == "APROBADO"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F30" sourceRef="GW_Director" targetRef="NotificarRechazo" name="RECHAZADO"/>
    <bpmn:sequenceFlow id="F31" sourceRef="AgendarFirma" targetRef="RegistrarFirma"/>
    <bpmn:sequenceFlow id="F32" sourceRef="RegistrarFirma" targetRef="GW_Firma"/>
    <bpmn:sequenceFlow id="F33" sourceRef="GW_Firma" targetRef="Desembolso" name="SI"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="groovy">solicitud.firmaPagare.firmado == true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F34" sourceRef="GW_Firma" targetRef="AgendarFirma" name="NO"/>
    <bpmn:sequenceFlow id="F35" sourceRef="Desembolso" targetRef="EndAprobado"/>
    <bpmn:sequenceFlow id="F36" sourceRef="NotificarRechazo" targetRef="EndRechazo"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D"><bpmndi:BPMNPlane id="P" bpmnElement="Collab">
